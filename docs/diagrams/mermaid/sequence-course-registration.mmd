sequenceDiagram
    actor Student
    participant UI as Registration Page
    participant API as Student API
    participant Service as Student Service
    participant DB as MySQL

    Student->>UI: Open registration workspace
    UI->>API: GET /students/me/registration
    API->>Service: Build registration workspace
    Service->>DB: Query program curriculum, offerings, enrollments
    DB-->>Service: Available offerings and selected courses
    Service-->>API: Registration payload
    API-->>UI: Workspace data

    Student->>UI: Click Register on an offering
    UI->>API: POST /students/me/registration
    API->>Service: Validate registration request
    Service->>DB: Check prerequisites, capacity, duplicates, term status

    alt Registration accepted
        DB-->>Service: Validation passed
        Service->>DB: Insert enrollment and audit log
        Service-->>API: Updated registration state
        API-->>UI: Success response
        UI-->>Student: Enrollment visible in selected courses
    else Validation failed
        DB-->>Service: Conflict or rule violation
        Service-->>API: Business error
        API-->>UI: 400 or 409 response
        UI-->>Student: Explain why registration was blocked
    end
