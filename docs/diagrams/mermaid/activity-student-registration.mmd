flowchart TD
    start([Student opens registration])
    load[Load available offerings and selected courses]
    choose[Student selects an offering]
    term{Current term open for registration?}
    duplicate{Already selected or completed?}
    capacity{Seats available?}
    prerequisite{Prerequisites satisfied?}
    create[Create enrollment]
    notify[Write audit log and optional notification]
    success([Registration confirmed])
    reject([Explain rejection reason])

    start --> load --> choose --> term
    term -- No --> reject
    term -- Yes --> duplicate
    duplicate -- Yes --> reject
    duplicate -- No --> capacity
    capacity -- No --> reject
    capacity -- Yes --> prerequisite
    prerequisite -- No --> reject
    prerequisite -- Yes --> create --> notify --> success
