<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Def_GradePublication"
                  targetNamespace="http://cis.edu/bpmn">
  <bpmn:collaboration id="Collab_Grade">
    <bpmn:participant id="Pool_I" name="Instructor" processRef="Proc_I"/>
    <bpmn:participant id="Pool_Sys" name="CIS Backend" processRef="Proc_Sys"/>
    <bpmn:participant id="Pool_S" name="Student" processRef="Proc_S"/>
    <bpmn:messageFlow id="MF1" sourceRef="Task_SaveConfig" targetRef="Task_PersistConfig"/>
    <bpmn:messageFlow id="MF2" sourceRef="Task_EnterScores" targetRef="Task_UpsertGrade"/>
    <bpmn:messageFlow id="MF3" sourceRef="Task_Publish" targetRef="Task_FlipPublished"/>
    <bpmn:messageFlow id="MF4" sourceRef="Task_FlipPublished" targetRef="Event_ScoresVisible"/>
  </bpmn:collaboration>

  <bpmn:process id="Proc_I" isExecutable="false">
    <bpmn:startEvent id="E_IStart" name="Open grades page"/>
    <bpmn:task id="Task_SaveConfig" name="Configure weights"/>
    <bpmn:task id="Task_EnterScores" name="Enter component scores"/>
    <bpmn:exclusiveGateway id="GW_PubChoice" name="Publish?"/>
    <bpmn:task id="Task_SaveDraft" name="Save as draft"/>
    <bpmn:task id="Task_Publish" name="Publish grades"/>
    <bpmn:endEvent id="E_IEnd"/>
    <bpmn:sequenceFlow id="f1" sourceRef="E_IStart" targetRef="Task_SaveConfig"/>
    <bpmn:sequenceFlow id="f2" sourceRef="Task_SaveConfig" targetRef="Task_EnterScores"/>
    <bpmn:sequenceFlow id="f3" sourceRef="Task_EnterScores" targetRef="GW_PubChoice"/>
    <bpmn:sequenceFlow id="f4" name="Later" sourceRef="GW_PubChoice" targetRef="Task_SaveDraft"/>
    <bpmn:sequenceFlow id="f5" name="Now" sourceRef="GW_PubChoice" targetRef="Task_Publish"/>
    <bpmn:sequenceFlow id="f6" sourceRef="Task_SaveDraft" targetRef="E_IEnd"/>
    <bpmn:sequenceFlow id="f7" sourceRef="Task_Publish" targetRef="E_IEnd"/>
  </bpmn:process>

  <bpmn:process id="Proc_Sys" isExecutable="false">
    <bpmn:task id="Task_PersistConfig" name="Persist grade config"/>
    <bpmn:task id="Task_UpsertGrade" name="Upsert grade (is_published=false)"/>
    <bpmn:task id="Task_FlipPublished" name="Flip is_published=true"/>
    <bpmn:endEvent id="E_SysEnd"/>
    <bpmn:sequenceFlow id="g1" sourceRef="Task_PersistConfig" targetRef="Task_UpsertGrade"/>
    <bpmn:sequenceFlow id="g2" sourceRef="Task_UpsertGrade" targetRef="Task_FlipPublished"/>
    <bpmn:sequenceFlow id="g3" sourceRef="Task_FlipPublished" targetRef="E_SysEnd"/>
  </bpmn:process>

  <bpmn:process id="Proc_S" isExecutable="false">
    <bpmn:intermediateCatchEvent id="Event_ScoresVisible" name="Grades published"/>
    <bpmn:task id="Task_OpenGrades" name="GET /grades/me"/>
    <bpmn:endEvent id="E_SEnd" name="View final scores"/>
    <bpmn:sequenceFlow id="h1" sourceRef="Event_ScoresVisible" targetRef="Task_OpenGrades"/>
    <bpmn:sequenceFlow id="h2" sourceRef="Task_OpenGrades" targetRef="E_SEnd"/>
  </bpmn:process>

  <bpmndi:BPMNDiagram id="DI">
    <bpmndi:BPMNPlane id="P" bpmnElement="Collab_Grade">
      <bpmndi:BPMNShape id="Pool_I_di" bpmnElement="Pool_I" isHorizontal="true">
        <dc:Bounds x="100" y="40" width="1280" height="160"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E_IStart_di" bpmnElement="E_IStart">
        <dc:Bounds x="160" y="100" width="36" height="36"/>
        <bpmndi:BPMNLabel><dc:Bounds x="140" y="140" width="80" height="30"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SaveConfig_di" bpmnElement="Task_SaveConfig">
        <dc:Bounds x="240" y="80" width="120" height="76"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_EnterScores_di" bpmnElement="Task_EnterScores">
        <dc:Bounds x="400" y="80" width="140" height="76"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_PubChoice_di" bpmnElement="GW_PubChoice" isMarkerVisible="true">
        <dc:Bounds x="580" y="98" width="40" height="40"/>
        <bpmndi:BPMNLabel><dc:Bounds x="585" y="145" width="40" height="20"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SaveDraft_di" bpmnElement="Task_SaveDraft">
        <dc:Bounds x="660" y="40" width="120" height="60"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Publish_di" bpmnElement="Task_Publish">
        <dc:Bounds x="660" y="125" width="120" height="60"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E_IEnd_di" bpmnElement="E_IEnd">
        <dc:Bounds x="820" y="100" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Pool_Sys_di" bpmnElement="Pool_Sys" isHorizontal="true">
        <dc:Bounds x="100" y="220" width="1280" height="160"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_PersistConfig_di" bpmnElement="Task_PersistConfig">
        <dc:Bounds x="240" y="260" width="140" height="76"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_UpsertGrade_di" bpmnElement="Task_UpsertGrade">
        <dc:Bounds x="420" y="260" width="180" height="76"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_FlipPublished_di" bpmnElement="Task_FlipPublished">
        <dc:Bounds x="640" y="260" width="180" height="76"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E_SysEnd_di" bpmnElement="E_SysEnd">
        <dc:Bounds x="860" y="280" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Pool_S_di" bpmnElement="Pool_S" isHorizontal="true">
        <dc:Bounds x="100" y="400" width="1280" height="160"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_ScoresVisible_di" bpmnElement="Event_ScoresVisible">
        <dc:Bounds x="660" y="460" width="36" height="36"/>
        <bpmndi:BPMNLabel><dc:Bounds x="630" y="500" width="100" height="30"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_OpenGrades_di" bpmnElement="Task_OpenGrades">
        <dc:Bounds x="740" y="440" width="140" height="76"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E_SEnd_di" bpmnElement="E_SEnd">
        <dc:Bounds x="920" y="460" width="36" height="36"/>
        <bpmndi:BPMNLabel><dc:Bounds x="895" y="500" width="100" height="30"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
