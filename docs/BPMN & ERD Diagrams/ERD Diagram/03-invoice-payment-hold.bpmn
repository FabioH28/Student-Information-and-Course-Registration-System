<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Def_Finance"
                  targetNamespace="http://cis.edu/bpmn">
  <bpmn:collaboration id="Collab_Finance">
    <bpmn:participant id="Pool_F" name="Finance Staff" processRef="Proc_F"/>
    <bpmn:participant id="Pool_Sys" name="CIS Backend" processRef="Proc_Sys"/>
    <bpmn:participant id="Pool_St" name="Student" processRef="Proc_St"/>
    <bpmn:messageFlow id="m1" sourceRef="Task_Issue" targetRef="Task_StoreInvoice"/>
    <bpmn:messageFlow id="m2" sourceRef="Task_StoreInvoice" targetRef="Event_InvoiceReceived"/>
    <bpmn:messageFlow id="m3" sourceRef="Task_Pay" targetRef="Task_RecordPayment"/>
    <bpmn:messageFlow id="m4" sourceRef="Task_PlaceHold" targetRef="Task_StoreHold"/>
    <bpmn:messageFlow id="m5" sourceRef="Task_StoreHold" targetRef="Event_HoldNotified"/>
  </bpmn:collaboration>

  <bpmn:process id="Proc_F" isExecutable="false">
    <bpmn:startEvent id="E_FStart" name="Bill cycle"/>
    <bpmn:task id="Task_Issue" name="Issue invoice"/>
    <bpmn:exclusiveGateway id="GW_Wait" name="Paid in time?"/>
    <bpmn:task id="Task_PlaceHold" name="Place hold"/>
    <bpmn:task id="Task_ReleaseHold" name="Release hold"/>
    <bpmn:endEvent id="E_FEnd"/>
    <bpmn:sequenceFlow id="f1" sourceRef="E_FStart" targetRef="Task_Issue"/>
    <bpmn:sequenceFlow id="f2" sourceRef="Task_Issue" targetRef="GW_Wait"/>
    <bpmn:sequenceFlow id="f3" name="Yes" sourceRef="GW_Wait" targetRef="E_FEnd"/>
    <bpmn:sequenceFlow id="f4" name="Overdue" sourceRef="GW_Wait" targetRef="Task_PlaceHold"/>
    <bpmn:sequenceFlow id="f5" sourceRef="Task_PlaceHold" targetRef="Task_ReleaseHold"/>
    <bpmn:sequenceFlow id="f6" sourceRef="Task_ReleaseHold" targetRef="E_FEnd"/>
  </bpmn:process>

  <bpmn:process id="Proc_Sys" isExecutable="false">
    <bpmn:task id="Task_StoreInvoice" name="Store invoice (unpaid)"/>
    <bpmn:task id="Task_RecordPayment" name="Record payment + update balance"/>
    <bpmn:task id="Task_StoreHold" name="Insert hold (active=true)"/>
    <bpmn:task id="Task_ReleaseStored" name="Mark hold released"/>
    <bpmn:endEvent id="E_SysEnd"/>
    <bpmn:sequenceFlow id="g1" sourceRef="Task_StoreInvoice" targetRef="Task_RecordPayment"/>
    <bpmn:sequenceFlow id="g2" sourceRef="Task_RecordPayment" targetRef="Task_StoreHold"/>
    <bpmn:sequenceFlow id="g3" sourceRef="Task_StoreHold" targetRef="Task_ReleaseStored"/>
    <bpmn:sequenceFlow id="g4" sourceRef="Task_ReleaseStored" targetRef="E_SysEnd"/>
  </bpmn:process>

  <bpmn:process id="Proc_St" isExecutable="false">
    <bpmn:intermediateCatchEvent id="Event_InvoiceReceived" name="Invoice posted"/>
    <bpmn:task id="Task_Pay" name="Submit payment"/>
    <bpmn:intermediateCatchEvent id="Event_HoldNotified" name="Hold placed on account"/>
    <bpmn:endEvent id="E_StEnd"/>
    <bpmn:sequenceFlow id="h1" sourceRef="Event_InvoiceReceived" targetRef="Task_Pay"/>
    <bpmn:sequenceFlow id="h2" sourceRef="Task_Pay" targetRef="E_StEnd"/>
    <bpmn:sequenceFlow id="h3" sourceRef="Event_HoldNotified" targetRef="E_StEnd"/>
  </bpmn:process>

  <bpmndi:BPMNDiagram id="DI">
    <bpmndi:BPMNPlane id="P" bpmnElement="Collab_Finance">
      <bpmndi:BPMNShape id="Pool_F_di" bpmnElement="Pool_F" isHorizontal="true">
        <dc:Bounds x="100" y="40" width="1280" height="160"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E_FStart_di" bpmnElement="E_FStart">
        <dc:Bounds x="160" y="100" width="36" height="36"/>
        <bpmndi:BPMNLabel><dc:Bounds x="145" y="140" width="70" height="30"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Issue_di" bpmnElement="Task_Issue">
        <dc:Bounds x="240" y="80" width="120" height="76"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_Wait_di" bpmnElement="GW_Wait" isMarkerVisible="true">
        <dc:Bounds x="400" y="98" width="40" height="40"/>
        <bpmndi:BPMNLabel><dc:Bounds x="380" y="145" width="80" height="20"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_PlaceHold_di" bpmnElement="Task_PlaceHold">
        <dc:Bounds x="480" y="80" width="120" height="76"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ReleaseHold_di" bpmnElement="Task_ReleaseHold">
        <dc:Bounds x="640" y="80" width="120" height="76"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E_FEnd_di" bpmnElement="E_FEnd">
        <dc:Bounds x="800" y="100" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Pool_Sys_di" bpmnElement="Pool_Sys" isHorizontal="true">
        <dc:Bounds x="100" y="220" width="1280" height="160"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_StoreInvoice_di" bpmnElement="Task_StoreInvoice">
        <dc:Bounds x="240" y="260" width="160" height="76"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_RecordPayment_di" bpmnElement="Task_RecordPayment">
        <dc:Bounds x="430" y="260" width="200" height="76"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_StoreHold_di" bpmnElement="Task_StoreHold">
        <dc:Bounds x="660" y="260" width="160" height="76"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ReleaseStored_di" bpmnElement="Task_ReleaseStored">
        <dc:Bounds x="860" y="260" width="160" height="76"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E_SysEnd_di" bpmnElement="E_SysEnd">
        <dc:Bounds x="1060" y="280" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Pool_St_di" bpmnElement="Pool_St" isHorizontal="true">
        <dc:Bounds x="100" y="400" width="1280" height="160"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_InvoiceReceived_di" bpmnElement="Event_InvoiceReceived">
        <dc:Bounds x="260" y="460" width="36" height="36"/>
        <bpmndi:BPMNLabel><dc:Bounds x="235" y="500" width="100" height="30"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Pay_di" bpmnElement="Task_Pay">
        <dc:Bounds x="340" y="440" width="120" height="76"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_HoldNotified_di" bpmnElement="Event_HoldNotified">
        <dc:Bounds x="700" y="460" width="36" height="36"/>
        <bpmndi:BPMNLabel><dc:Bounds x="660" y="500" width="120" height="30"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E_StEnd_di" bpmnElement="E_StEnd">
        <dc:Bounds x="900" y="460" width="36" height="36"/>
      </bpmndi:BPMNShape>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
