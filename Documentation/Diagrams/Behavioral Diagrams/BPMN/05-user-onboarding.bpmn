<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Def_Onboarding"
                  targetNamespace="http://cis.edu/bpmn">
  <bpmn:collaboration id="Collab_OB">
    <bpmn:participant id="Pool_A" name="System Admin" processRef="Proc_A"/>
    <bpmn:participant id="Pool_Sys" name="CIS Backend" processRef="Proc_Sys"/>
    <bpmn:participant id="Pool_New" name="New User" processRef="Proc_New"/>
    <bpmn:messageFlow id="m1" sourceRef="Task_FillForm" targetRef="Task_ValidateEmail"/>
    <bpmn:messageFlow id="m2" sourceRef="Task_Persist" targetRef="Event_Credentials"/>
    <bpmn:messageFlow id="m3" sourceRef="Task_Login" targetRef="Task_VerifyLogin"/>
    <bpmn:messageFlow id="m4" sourceRef="Task_ChangePW" targetRef="Task_UpdateHash"/>
  </bpmn:collaboration>

  <bpmn:process id="Proc_A" isExecutable="false">
    <bpmn:startEvent id="E_AStart" name="New person admitted"/>
    <bpmn:task id="Task_FillForm" name="Fill Create User form"/>
    <bpmn:exclusiveGateway id="GW_Valid" name="Email unique?"/>
    <bpmn:task id="Task_Adjust" name="Adjust form"/>
    <bpmn:task id="Task_ShareCreds" name="Securely share temp password"/>
    <bpmn:endEvent id="E_AEnd"/>
    <bpmn:sequenceFlow id="f1" sourceRef="E_AStart" targetRef="Task_FillForm"/>
    <bpmn:sequenceFlow id="f2" sourceRef="Task_FillForm" targetRef="GW_Valid"/>
    <bpmn:sequenceFlow id="f3" name="No" sourceRef="GW_Valid" targetRef="Task_Adjust"/>
    <bpmn:sequenceFlow id="f4" sourceRef="Task_Adjust" targetRef="Task_FillForm"/>
    <bpmn:sequenceFlow id="f5" name="Yes" sourceRef="GW_Valid" targetRef="Task_ShareCreds"/>
    <bpmn:sequenceFlow id="f6" sourceRef="Task_ShareCreds" targetRef="E_AEnd"/>
  </bpmn:process>

  <bpmn:process id="Proc_Sys" isExecutable="false">
    <bpmn:task id="Task_ValidateEmail" name="Validate email uniqueness"/>
    <bpmn:task id="Task_HashTemp" name="bcrypt(temp_password)"/>
    <bpmn:task id="Task_Persist" name="INSERT users + role row + audit"/>
    <bpmn:task id="Task_VerifyLogin" name="Verify password + JWT"/>
    <bpmn:exclusiveGateway id="GW_FirstLogin" name="is_first_login?"/>
    <bpmn:task id="Task_RequireChange" name="Return require_password_change=true"/>
    <bpmn:task id="Task_UpdateHash" name="Update hash + is_first_login=false"/>
    <bpmn:endEvent id="E_SysEnd"/>
    <bpmn:sequenceFlow id="g1" sourceRef="Task_ValidateEmail" targetRef="Task_HashTemp"/>
    <bpmn:sequenceFlow id="g2" sourceRef="Task_HashTemp" targetRef="Task_Persist"/>
    <bpmn:sequenceFlow id="g3" sourceRef="Task_Persist" targetRef="Task_VerifyLogin"/>
    <bpmn:sequenceFlow id="g4" sourceRef="Task_VerifyLogin" targetRef="GW_FirstLogin"/>
    <bpmn:sequenceFlow id="g5" name="Yes" sourceRef="GW_FirstLogin" targetRef="Task_RequireChange"/>
    <bpmn:sequenceFlow id="g6" sourceRef="Task_RequireChange" targetRef="Task_UpdateHash"/>
    <bpmn:sequenceFlow id="g7" sourceRef="Task_UpdateHash" targetRef="E_SysEnd"/>
    <bpmn:sequenceFlow id="g8" name="No" sourceRef="GW_FirstLogin" targetRef="E_SysEnd"/>
  </bpmn:process>

  <bpmn:process id="Proc_New" isExecutable="false">
    <bpmn:intermediateCatchEvent id="Event_Credentials" name="Receive temp pw"/>
    <bpmn:task id="Task_Login" name="Sign in"/>
    <bpmn:task id="Task_ChangePW" name="Change to new password"/>
    <bpmn:endEvent id="E_NewEnd" name="Workspace access"/>
    <bpmn:sequenceFlow id="h1" sourceRef="Event_Credentials" targetRef="Task_Login"/>
    <bpmn:sequenceFlow id="h2" sourceRef="Task_Login" targetRef="Task_ChangePW"/>
    <bpmn:sequenceFlow id="h3" sourceRef="Task_ChangePW" targetRef="E_NewEnd"/>
  </bpmn:process>

  <bpmndi:BPMNDiagram id="DI">
    <bpmndi:BPMNPlane id="P" bpmnElement="Collab_OB">
      <bpmndi:BPMNShape id="Pool_A_di" bpmnElement="Pool_A" isHorizontal="true">
        <dc:Bounds x="100" y="40" width="1380" height="160"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E_AStart_di" bpmnElement="E_AStart">
        <dc:Bounds x="160" y="100" width="36" height="36"/>
        <bpmndi:BPMNLabel><dc:Bounds x="135" y="140" width="100" height="30"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_FillForm_di" bpmnElement="Task_FillForm">
        <dc:Bounds x="240" y="80" width="160" height="76"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_Valid_di" bpmnElement="GW_Valid" isMarkerVisible="true">
        <dc:Bounds x="440" y="98" width="40" height="40"/>
        <bpmndi:BPMNLabel><dc:Bounds x="425" y="145" width="80" height="20"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Adjust_di" bpmnElement="Task_Adjust">
        <dc:Bounds x="520" y="40" width="120" height="60"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ShareCreds_di" bpmnElement="Task_ShareCreds">
        <dc:Bounds x="520" y="120" width="200" height="60"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E_AEnd_di" bpmnElement="E_AEnd">
        <dc:Bounds x="760" y="140" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Pool_Sys_di" bpmnElement="Pool_Sys" isHorizontal="true">
        <dc:Bounds x="100" y="220" width="1380" height="220"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ValidateEmail_di" bpmnElement="Task_ValidateEmail">
        <dc:Bounds x="240" y="240" width="200" height="60"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_HashTemp_di" bpmnElement="Task_HashTemp">
        <dc:Bounds x="460" y="240" width="200" height="60"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Persist_di" bpmnElement="Task_Persist">
        <dc:Bounds x="680" y="240" width="240" height="60"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_VerifyLogin_di" bpmnElement="Task_VerifyLogin">
        <dc:Bounds x="940" y="240" width="200" height="60"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_FirstLogin_di" bpmnElement="GW_FirstLogin" isMarkerVisible="true">
        <dc:Bounds x="1160" y="250" width="40" height="40"/>
        <bpmndi:BPMNLabel><dc:Bounds x="1140" y="295" width="100" height="20"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_RequireChange_di" bpmnElement="Task_RequireChange">
        <dc:Bounds x="1220" y="240" width="240" height="60"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_UpdateHash_di" bpmnElement="Task_UpdateHash">
        <dc:Bounds x="1220" y="340" width="240" height="60"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E_SysEnd_di" bpmnElement="E_SysEnd">
        <dc:Bounds x="1180" y="360" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Pool_New_di" bpmnElement="Pool_New" isHorizontal="true">
        <dc:Bounds x="100" y="460" width="1380" height="160"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_Credentials_di" bpmnElement="Event_Credentials">
        <dc:Bounds x="660" y="520" width="36" height="36"/>
        <bpmndi:BPMNLabel><dc:Bounds x="635" y="560" width="100" height="30"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Login_di" bpmnElement="Task_Login">
        <dc:Bounds x="740" y="500" width="140" height="76"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ChangePW_di" bpmnElement="Task_ChangePW">
        <dc:Bounds x="920" y="500" width="200" height="76"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E_NewEnd_di" bpmnElement="E_NewEnd">
        <dc:Bounds x="1160" y="520" width="36" height="36"/>
        <bpmndi:BPMNLabel><dc:Bounds x="1130" y="560" width="100" height="30"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
